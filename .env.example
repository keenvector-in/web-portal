VITE_API_BASE_URL=
VITE_APP_ENV=development
VITE_ENABLE_WHATSAPP=false
VITE_ENABLE_ANALYTICS=false

# Meta Embedded Signup for WhatsApp Business. Leave both empty to exercise the
# connect flow against a mock (no real Meta app needed) — see WhatsAppOnboardingService.
VITE_META_APP_ID=
VITE_WHATSAPP_CONFIG_ID=

# Website chatbot (tenant-portal's embeddable widget) — our own tenant's bot on our site.
VITE_CHAT_WIDGET_URL=
VITE_CHAT_SITE_SLUG=keenvector-in
# tenant-site's public HTTP base (local: http://localhost:8083). REQUIRED — the contact
# form posts leads here and has no mock fallback, so empty means every submit fails.
VITE_CHAT_API_BASE_URL=
